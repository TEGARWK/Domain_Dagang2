# ============================================================
#  FRONTEND ENVIRONMENT CONFIGURATION
#  Domain Dagang (Vite + React)
#
#  IMPORTANT: Copy this file to .env and fill in all values
#  Variables MUST start with VITE_ to be accessible in the browser
# ============================================================

# ============================================================
#  API CONFIGURATION
# ============================================================

# Backend API URL (in production, this should be your API server)
VITE_API_URL=https://api.your-domain.com/api

# ============================================================
#  GOOGLE OAUTH
# ============================================================

# Google OAuth Client ID from Google Cloud Console
# This is PUBLIC and safe to expose in frontend
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ============================================================
#  APP CONFIGURATION
# ============================================================

# Application name
VITE_APP_NAME=Domain Dagang

# Default currency
VITE_DEFAULT_CURRENCY=IDR

# Support contact
VITE_SUPPORT_EMAIL=support@your-domain.com
VITE_SUPPORT_PHONE=+6281234567890
