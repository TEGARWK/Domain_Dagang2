<%- include('header') %>
    <h3 class="text-orange font-bold text-center" style="font-size: 20px; border-bottom: 2px solid #fdba74; padding-bottom: 10px; margin-top: 0;">Pembayaran Berhasil</h3>
    
    <p>Halo <strong class="font-bold"><%= user.name %></strong>,</p>
    
    <div style="background-color: #dcfce7; border-left: 4px solid #16a34a; padding: 15px; margin: 20px 0; color: #166534;">
        <strong class="font-bold">✅ Berhasil!</strong> Pembayaran Anda telah kami terima.
    </div>

    <p>Terima kasih telah melakukan konfirmasi pembayaran. Berikut adalah rincian transaksi Anda:</p>

    <table class="table-wrap">
        <tr>
            <td style="font-weight: 600; width: 140px;">No. Invoice</td>
            <td><strong class="text-orange">#<%= invoice.id %></strong></td>
        </tr>
        <tr>
            <td style="font-weight: 600;">Layanan</td>
            <td>Pendaftaran/Perpanjangan Domain <%= domain %></td>
        </tr>
        <tr>
            <td style="font-weight: 600;">Total</td>
            <td class="font-bold">Rp <%= parseInt(invoice.total).toLocaleString('id-ID') %></td>
        </tr>
        <tr>
            <td style="font-weight: 600;">Tanggal</td>
            <td><%= new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %></td>
        </tr>
    </table>

    <div class="text-center">
        <a href="<%= process.env.FRONTEND_URL || 'http://localhost:5173' %>/dashboard/invoices/<%= invoice.id %>" class="btn">Lihat Invoice</a>
    </div>

    <p style="margin-top: 30px; font-size: 14px; color: #64748b;">
        Jika Anda memiliki pertanyaan seputar tagihan ini, silakan balas email ini atau hubungi tim support kami.
    </p>
<%- include('footer') %>
