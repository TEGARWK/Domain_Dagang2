<!DOCTYPE html>
<html>
<head>
    <style>
        body { font-family: Arial, sans-serif; color: #333; }
        .container { max-width: 600px; margin: 0 auto; padding: 20px; border: 1px solid #eee; border-radius: 10px; }
        .header { background-color: #10b981; color: white; padding: 15px; text-align: center; border-radius: 10px 10px 0 0; }
        .content { padding: 20px; }
        .footer { text-align: center; font-size: 12px; color: #aaa; margin-top: 20px; }
        .proof { background: #f0fdf4; padding: 10px; border-left: 4px solid #10b981; margin: 10px 0; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h2>Penarikan Berhasil</h2>
        </div>
        <div class="content">
            <p>Halo <%= user.name %>,</p>
            <p>Dana penarikan sebesar <b>Rp <%= amount %></b> telah BERHASIL dikirim ke rekening Anda.</p>
            
            <% if (proof) { %>
            <div class="proof">
                <strong>Bukti Transfer / Ref ID:</strong><br>
                <%= proof %>
            </div>
            <% } %>

            <p>Silakan cek mutasi rekening Anda.</p>
        </div>
        <div class="footer">
            &copy; 2026 DagangDomain. All rights reserved.
        </div>
    </div>
</body>
</html>
