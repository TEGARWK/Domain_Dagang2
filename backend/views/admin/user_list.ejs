<div class="row section-title align-items-center">
    <div class="col">
        <h2 class="mb-1">Daftar User</h2>
        <p class="text-muted">Manajemen basis pelanggan dan pemantauan tier referral.</p>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="px-4 py-3 border-0">Nama & Email</th>
                        <th class="py-3 border-0">Sumber Referral</th>
                        <th class="py-3 border-0">Tier Referral</th>
                        <th class="py-3 border-0">Total Transaksi</th>
                        <th class="py-3 border-0">Total Belanja</th>
                        <th class="py-3 border-0">Tanggal Daftar</th>
                        <th class="px-4 py-3 border-0 text-end">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (users.length === 0) { %>
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">Belum ada user terdaftar.</td>
                        </tr>
                    <% } %>
                    <% users.forEach(u => { %>
                        <tr>
                            <td class="px-4">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px; font-size: 14px;">
                                        <%= u.name.charAt(0).toUpperCase() %>
                                    </div>
                                    <div>
                                        <div class="fw-bold"><%= u.name %></div>
                                        <div class="small text-muted"><%= u.email %></div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <% if (u.referred_by_id) { %>
                                    <span class="badge bg-info-subtle text-info border border-info-subtle">
                                        <i class="fas fa-link me-1"></i> Referral
                                    </span>
                                <% } else { %>
                                    <span class="badge bg-light text-muted border">Organik</span>
                                <% } %>
                            </td>
                            <td>
                                <% 
                                    let bClass = 'bg-secondary';
                                    if(u.referral_tier === 'Gold') bClass = 'bg-warning text-dark';
                                    else if(u.referral_tier === 'Silver') bClass = 'bg-info text-white';
                                %>
                                <span class="badge <%= bClass %> px-3 rounded-pill"><%= u.referral_tier || 'Starter' %></span>
                            </td>
                            <td class="text-center fw-bold">
                                <%= u.total_orders || 0 %>
                            </td>
                            <td class="fw-bold text-success text-nowrap">
                                Rp <%= parseFloat(u.total_spent || 0).toLocaleString('id-ID') %>
                            </td>
                            <td class="small text-muted">
                                <%= new Date(u.created_at).toLocaleDateString('id-ID') %>
                            </td>
                            <td class="px-4 text-end">
                                <button class="btn btn-light btn-sm rounded-3">
                                    <i class="fas fa-user-edit"></i>
                                </button>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>
