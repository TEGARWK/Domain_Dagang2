<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Admin' %> | Admin DagangDomain</title>
    
    <!-- CSS: Local Vendor Assets -->
    <link href="/public/vendor/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/public/vendor/all.min.css">
    
    <!-- JS: Local Vendor Asset -->
    <script src="/public/vendor/sweetalert2.min.js"></script>

    <!-- Google Fonts: Plus Jakarta Sans -->
    <!-- PERINTAH IMPLEMENTASI LOKAL:
         1. Karena Vite dan backend ini terhubung, pastikan meng-host font Plus Jakarta Sans secara manual.
         2. Buka folder proyek, buang URL Google Font ini, pindahkan WOFF2 ke public/fonts.
         3. Panggil di index.css atau di stylesheet khusus seperti ini:
            @font-face {
                font-family: 'Plus Jakarta Sans';
                font-style: normal;
                font-weight: 400 800;
                src: url('/public/fonts/plus-jakarta-sans.woff2') format('woff2');
            }
     -->
    <!-- <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet"> -->
    
    <style>
        :root {
            --sidebar-width: 260px;
            --primary-orange: #F97316;
            --bg-body: #F8FAFC;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--bg-body);
            color: #1E293B;
        }

        /* Sidebar Styling */
        .sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            background: #FFFFFF;
            border-right: 1px solid #E2E8F0;
            z-index: 1000;
            padding: 24px 16px;
        }

        .sidebar-brand {
            padding: 0 12px 32px;
            font-size: 1.25rem;
            font-weight: 800;
            color: var(--primary-orange);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            color: #64748B;
            border-radius: 12px;
            font-weight: 600;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            margin-bottom: 4px;
        }

        .nav-link:hover {
            background-color: #F1F5F9;
            color: var(--primary-orange);
        }

        .nav-link.active {
            background-color: #FFF7ED;
            color: var(--primary-orange);
        }

        .nav-link i {
            font-size: 1.1rem;
            width: 20px;
            text-align: center;
        }

        /* Main Content Styling */
        .main-content {
            margin-left: var(--sidebar-width);
            padding: 32px;
            min-height: 100vh;
        }

        /* Premium Components */
        .card {
            border: none;
            border-radius: 20px;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05), 0 1px 2px 0 rgba(0, 0, 0, 0.03);
            transition: transform 0.2s;
        }

        .btn-primary {
            background-color: var(--primary-orange);
            border-color: var(--primary-orange);
            border-radius: 12px;
            padding: 10px 24px;
            font-weight: 600;
            box-shadow: 0 4px 14px rgba(249, 115, 22, 0.2);
        }

        .btn-primary:hover {
            background-color: #EA580C;
            border-color: #EA580C;
            transform: translateY(-1px);
        }

        .section-title {
            font-weight: 800;
            letter-spacing: -0.025em;
            margin-bottom: 32px;
        }

        /* Responsive Mobile */
        @media (max-width: 992px) {
            .sidebar { left: -100%; }
            .main-content { margin-left: 0; }
        }
    </style>
</head>
<body>

    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="sidebar-brand">
            <i class="fas fa-rocket"></i>
            <span>DOMAIN DASH</span>
        </div>
        
        <nav class="nav flex-column">
            <p class="text-uppercase text-muted fw-bold small px-3 mb-2" style="font-size: 10px; letter-spacing: 1px;">Menu Utama</p>
            <a class="nav-link <%= (typeof activePage !== 'undefined' && activePage === 'dashboard') ? 'active' : '' %>" href="/admin/dashboard">
                <i class="fas fa-chart-pie"></i> Dashboard
            </a>
            
            <p class="text-uppercase text-muted fw-bold small px-3 mt-4 mb-2" style="font-size: 10px; letter-spacing: 1px;">Sistem Promo</p>
            <a class="nav-link <%= (typeof activePage !== 'undefined' && activePage === 'vouchers') ? 'active' : '' %>" href="/admin/vouchers">
                <i class="fas fa-ticket-alt"></i> Managemen Voucher
            </a>
            <a class="nav-link <%= (typeof activePage !== 'undefined' && activePage === 'referral') ? 'active' : '' %>" href="/admin/referral">
                <i class="fas fa-users-rays"></i> Sistem Referral
            </a>
            
            <p class="text-uppercase text-muted fw-bold small px-3 mt-4 mb-2" style="font-size: 10px; letter-spacing: 1px;">Operasional</p>
            <a class="nav-link <%= (typeof activePage !== 'undefined' && activePage === 'transactions') ? 'active' : '' %>" href="/admin/transactions">
                <i class="fas fa-receipt"></i> Transaksi
            </a>
            <a class="nav-link <%= (typeof activePage !== 'undefined' && activePage === 'users') ? 'active' : '' %>" href="/admin/users">
                <i class="fas fa-user-group"></i> Daftar User
            </a>
            
            <div class="mt-auto pt-5">
                <a class="nav-link text-danger" href="/api/auth/logout">
                    <i class="fas fa-sign-out-alt"></i> Keluar
                </a>
            </div>
        </nav>
    </aside>

    <!-- Main Content Area -->
    <main class="main-content">
        <%- body %>
    </main>

    <!-- Scripts -->
    <script src="/public/vendor/bootstrap.bundle.min.js"></script>
    <script src="/public/vendor/chart.js"></script>
    <script src="/public/vendor/jquery.min.js"></script>
    
    <!-- Injection Point for Page Specific Scripts -->
    <%- typeof scripts !== 'undefined' ? scripts : '' %>

</body>
</html>
