<div class="row section-title align-items-center">
    <div class="col">
        <h2 class="mb-1">Daftar Transaksi</h2>
        <p class="text-muted">Pantau seluruh arus kas dan status pembayaran masuk.</p>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="px-4 py-3 border-0">Invoice ID</th>
                        <th class="py-3 border-0">User</th>
                        <th class="py-3 border-0">Total Tagihan</th>
                        <th class="py-3 border-0">Diskon</th>
                        <th class="py-3 border-0">Metode Bayar</th>
                        <th class="py-3 border-0">Status</th>
                        <th class="py-3 border-0">Tanggal</th>
                        <th class="px-4 py-3 border-0 text-end">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (transactions.length === 0) { %>
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">Belum ada data transaksi.</td>
                        </tr>
                    <% } %>
                    <% transactions.forEach(t => { %>
                        <tr>
                            <td class="px-4 fw-bold"><%= t.id %></td>
                            <td>
                                <div class="fw-medium"><%= t.user_name %></div>
                            </td>
                            <td>Rp <%= parseFloat(t.total).toLocaleString('id-ID') %></td>
                            <td>
                                <% if (parseFloat(t.discount_amount || 0) > 0) { %>
                                    <span class="text-danger small fw-bold">- Rp <%= parseFloat(t.discount_amount).toLocaleString('id-ID') %></span>
                                    <div><span class="badge bg-secondary-subtle text-secondary small" style="font-size: 9px;"><%= t.discount_source %></span></div>
                                <% } else { %>
                                    <span class="text-muted small">-</span>
                                <% } %>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border"><%= t.payment_method || 'N/A' %></span>
                            </td>
                            <td>
                                <% 
                                    let sBadge = 'bg-secondary';
                                    if(t.status === 'paid') sBadge = 'bg-success';
                                    else if(t.status === 'pending') sBadge = 'bg-warning text-dark';
                                    else if(t.status === 'failed' || t.status === 'expired') sBadge = 'bg-danger';
                                %>
                                <span class="badge <%= sBadge %> px-3 rounded-pill text-uppercase" style="font-size: 10px;"><%= t.status %></span>
                            </td>
                            <td class="small text-muted">
                                <%= new Date(t.date).toLocaleDateString('id-ID') %>
                            </td>
                            <td class="px-4 text-end">
                                <button class="btn btn-light btn-sm rounded-3">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>
