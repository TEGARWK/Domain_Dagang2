# ============================================================
#  .env.example — Template Konfigurasi Backend Domain Dagang
#  Salin file ini menjadi .env dan isi nilainya.
#  JANGAN commit file .env ke repository!
# ============================================================

# ─── Database (PostgreSQL) ──────────────────────────────────
# Host server PostgreSQL (localhost jika lokal)
DB_HOST=localhost
# Port PostgreSQL, default: 5432
DB_PORT=5432
# Nama database
DB_NAME=domaindagang_db
# Username database
DB_USER=postgres
# Password database
DB_PASS=yourpassword
REDIS_URL=redis://localhost:6379

# ─── Server ─────────────────────────────────────────────────
# Port yang digunakan Express (default: 3009)
PORT=3009
# Mode environment: development | production
NODE_ENV=development

# ─── Autentikasi & JWT ──────────────────────────────────────
# Secret key untuk menandatangani JWT — gunakan string acak yang panjang
JWT_SECRET=ganti_dengan_string_random_yang_panjang_dan_aman

# Google OAuth2 Client ID (untuk login dengan Google)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ─── Email / SMTP ───────────────────────────────────────────
# Digunakan untuk kirim email verifikasi dan reset password
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=youruser@example.com
SMTP_PASS=yoursmtppassword
# Nama dan alamat pengirim yang tampil di email
SMTP_FROM="Domain Dagang" <no-reply@example.com>

# ─── URL Aplikasi ───────────────────────────────────────────
# URL frontend (digunakan untuk link callback, redirect, email)
CLIENT_URL=https://yourdomain.com
# URL backend sendiri (digunakan untuk callback webhook)
BACKEND_URL=https://api.yourdomain.com

# ─── Daftarnama (Registrar API) ─────────────────────────────
# API key dari panel Daftarnama
DAFTARNAMA_API_KEY=your_daftarnama_api_key
# IP yang diizinkan oleh Daftarnama untuk request API
DAFTARNAMA_AUTHORIZED_IP=your_server_ip
# Base URL API Daftarnama
DAFTARNAMA_BASE_URL=https://api.dnama.id/v2

# ─── PrismaLink (Payment Gateway) ───────────────────────────
# Merchant ID dari panel PrismaLink
PRISMALINK_MERCHANT_ID=your_merchant_id
# Key ID dari panel PrismaLink
PRISMALINK_KEY_ID=your_key_id
# Secret Key dari panel PrismaLink
PRISMALINK_SECRET_KEY=your_secret_key
# URL API PrismaLink
# Staging : https://api-staging.plink.co.id/gateway/v2
# Production: https://api.plink.co.id/gateway/v2
PRISMALINK_URL=https://api-staging.plink.co.id/gateway/v2

# ─── Tripay (Payment Gateway) ───────────────────────────────
# Merchant Code dari dashboard Tripay (Settings → Merchant)
# Contoh format: T12345
TRIPAY_MERCHANT_CODE=your_merchant_code

# API Key dari dashboard Tripay (Settings → API)
# Sandbox dimulai dengan "DEV-", Production dimulai dengan huruf lain
TRIPAY_API_KEY=your_api_key

# Private Key dari dashboard Tripay (Settings → API)
# Digunakan untuk membuat signature HMAC-SHA256
# Formula Closed : HMAC-SHA256(merchant_code + merchant_ref + amount, private_key)
# Formula Open   : HMAC-SHA256(merchant_code + method + merchant_ref, private_key)
TRIPAY_PRIVATE_KEY=your_private_key

# Base URL API Tripay sesuai mode yang digunakan:
# Sandbox    : https://tripay.co.id/api-sandbox/
# Production : https://tripay.co.id/api/
# CATATAN: Pastikan URL diakhiri dengan "/" (slash)
TRIPAY_BASE_URL=https://tripay.co.id/api-sandbox/

# Backward compat alias (sama dengan TRIPAY_BASE_URL)
TRIPAY_URL=https://tripay.co.id/api-sandbox/

# Mode operasi: sandbox | production
TRIPAY_MODE=sandbox

# Aktifkan IP whitelist untuk endpoint webhook Tripay (true/false)
TRIPAY_WHITELIST_ENABLED=true
