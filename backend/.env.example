# ============================================================
#  .env.example — Template Konfigurasi Backend Domain Dagang
#  SALIN file ini menjadi .env dan isi nilainya.
#  JANGAN commit file .env ke repository!
# ============================================================

# ============================================================
#  SERVER CONFIGURATION
# ============================================================

# Node environment: development | production
NODE_ENV=development

# Port yang digunakan Express (default: 3009)
PORT=3009

# ============================================================
#  DATABASE (PostgreSQL)
# ============================================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=domaindagang_db
DB_USER=postgres
DB_PASS=yourpassword
REDIS_URL=redis://localhost:6379

# ============================================================
#  JWT & Authentication
# ============================================================

# Secret key untuk menandatangani JWT — gunakan string acak yang panjang
# Generate dengan: openssl rand -base64 32
JWT_SECRET=ganti_dengan_string_random_yang_panjang_dan_aman_minimum_32_karakter

# Google OAuth2 Client ID (untuk login dengan Google)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ============================================================
#  CLIENT / FRONTEND URLs
# ============================================================

# URL frontend (digunakan untuk link callback, redirect, email)
CLIENT_URL=http://localhost:5173

# URL backend sendiri (digunakan untuk callback webhook)
BACKEND_URL=http://localhost:3009

# ============================================================
#  Email / SMTP
# ============================================================

# Digunakan untuk kirim email verifikasi dan reset password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youruser@gmail.com
SMTP_PASS=yoursmtppassword
# Nama dan alamat pengirim yang tampil di email
SMTP_FROM="Domain Dagang" <no-reply@example.com>

# ============================================================
#  Daftarnama (Registrar API)
# ============================================================

# API key dari panel Daftarnama
DAFTARNAMA_API_KEY=your_daftarnama_api_key

# IP yang diizinkan oleh Daftarnama untuk request API
DAFTARNAMA_AUTHORIZED_IP=your_server_ip

# Base URL API Daftarnama
# Sandbox: https://api.sandboxv2.daftarnama.id/
# Production: https://api.dnama.id/v2
DAFTARNAMA_BASE_URL=https://api.sandboxv2.daftarnama.id/

# API Request timeout (milliseconds)
DAFTARNAMA_TIMEOUT_MS=30000

# Default password untuk customer registrar baru
REGISTRAR_DEFAULT_PASS=SecureDefaultPassword123!

# ============================================================
#  Tripay (Payment Gateway)
# ============================================================

# Whitelist IP untuk webhook Tripay
# Check Tripay docs untuk IP server mereka yang terbaru
TRIPAY_WHITELIST_ENABLED=true
TRIPAY_WHITELIST_IPS=95.111.200.230,2a04:3543:1000:2310:ac92:4cff:fe87:63f9

# ============================================================
#  Activation Retry Configuration
# ============================================================

# Maximum retry attempts for failed domain activations
ACTIVATION_MAX_RETRIES=5

# ============================================================
#  Logging
# ============================================================

LOG_LEVEL=info

# ============================================================
#  Optional: Error Tracking (Sentry)
# ============================================================

# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
